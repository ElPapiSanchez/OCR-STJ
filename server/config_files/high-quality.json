{
  "lang": ["por"],
  "outputs": ["pdf", "txt"],
  "dpiVal": null,
  "otherParams": null,
  "engine": "tesserocr",
  "engineMode": 3,
  "segmentMode": 3,
  "thresholdMethod": 3,
  "compress": true,
  "preprocessing": {
    "enabled": true,
    "grayscale": true,
    "clahe": true,
    "clahe_clip_limit": 3.0,
    "clahe_tile_size": 8,
    "median_blur": true,
    "median_blur_kernel": 11,
    "threshold_method": "otsu",
    "adaptive_block_size": 25,
    "adaptive_c": 8,
    "morphological_opening": true,
    "morphological_closing": true,
    "morph_kernel_size": 9,
    "deskew": false
  }
}
